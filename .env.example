# Copie para .env.local e preencha com valores reais. NUNCA versione o .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (/api/generate)
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini ---
# Somente servidor
GEMINI_API_KEY=

# --- App ---
# "true" para simular a geração de imagens sem chamar o Gemini
MOCK_GENERATION=
