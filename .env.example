# Copie para .env.local e preencha com valores reais. NUNCA versione o .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (/api/generate: reserva de créditos e gravação das imagens). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini ---
# Somente servidor
GEMINI_API_KEY=
# Opcional; padrão atual recomendado para geração de imagens
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Opcional; tempo máximo de cada chamada ao provedor (10 a 300 segundos)
GEMINI_REQUEST_TIMEOUT_MS=120000

# --- App ---
# Limite de gerações por usuário por minuto (opcional; padrão 20)
RATE_LIMIT_PER_MINUTE=
# "true" simula a geração sem chamar o Gemini e sem debitar créditos. Só vale fora de produção.
MOCK_GENERATION=
