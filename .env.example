# Copie para .env.local e preencha com valores reais. NUNCA versione o .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (/api/generate: reserva de créditos e gravação das imagens). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter ---
# Somente servidor
OPENROUTER_API_KEY=
# Opcional; tier de precisão para fidelidade e edição com referências
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-sunburst
# Opcional; tempo máximo de cada chamada ao provedor (10 a 300 segundos, padrão 180s)
OPENROUTER_REQUEST_TIMEOUT_MS=180000
# Opcional; qualidade suportada pelo modelo (padrão max para preservar detalhes da peça)
OPENROUTER_IMAGE_QUALITY=max
# Opcional; compressão de saída 0 a 100, somente para modelos que a suportam
OPENROUTER_OUTPUT_COMPRESSION=

# --- App ---
# Limite de gerações por usuário por minuto (opcional; padrão 20)
RATE_LIMIT_PER_MINUTE=
# "true" simula a geração sem chamar o provedor e sem debitar créditos. Só vale fora de produção.
MOCK_GENERATION=
